---

<div id="cookie-notice" class="cookie-notice" hidden>
  <p>
    We use essential cookies and Google Analytics to understand how visitors use DivyaKatha.
    <a href="/cookies/">Learn more</a>
    ·
    <a href="/privacy-policy/">Privacy</a>
  </p>
  <button type="button" id="cookie-notice-dismiss" aria-label="Dismiss cookie notice">
    Got it
  </button>
</div>

<script>
  const STORAGE_KEY = 'divyakatha-cookie-notice-dismissed';

  function initCookieNotice() {
    const notice = document.getElementById('cookie-notice');
    const dismiss = document.getElementById('cookie-notice-dismiss');
    if (!notice || !dismiss) return;

    try {
      if (localStorage.getItem(STORAGE_KEY) === '1') return;
    } catch {
      /* localStorage unavailable — show notice anyway */
    }

    notice.hidden = false;

    dismiss.addEventListener('click', () => {
      notice.hidden = true;
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch {
        /* ignore */
      }
    });
  }

  initCookieNotice();
</script>

<style>
  .cookie-notice {
    position: fixed;
    z-index: 50;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: min(36rem, calc(100vw - 2rem));
    padding: 0.85rem 1rem 0.85rem 1.15rem;
    background: #fffdf8;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(97, 74, 38, 0.12);
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .cookie-notice p {
    margin: 0;
    flex: 1;
  }

  .cookie-notice a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: rgba(162, 90, 42, 0.35);
    text-underline-offset: 2px;
  }

  .cookie-notice a:hover {
    text-decoration-color: var(--link);
  }

  .cookie-notice button {
    flex-shrink: 0;
    font-family: var(--font-head);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--paper-deep);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }

  .cookie-notice button:hover {
    background: #fff;
    border-color: var(--marigold);
  }

  @media (max-width: 520px) {
    .cookie-notice {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }

    .cookie-notice button {
      align-self: center;
    }
  }
</style>
