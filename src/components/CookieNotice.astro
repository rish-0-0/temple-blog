<div id="cookie-notice" class="cookie-notice" hidden role="status" aria-live="polite">
  <p>
    We use cookies for analytics tracking on DivyaKatha.
    <a href="/cookies/">Cookies</a>
    ·
    <a href="/privacy-policy/">Privacy</a>
  </p>
  <button type="button" id="cookie-notice-dismiss" aria-label="Close cookie notice">
    <span aria-hidden="true">×</span>
  </button>
</div>

<script is:inline>
  (function () {
    var COOKIE_NAME = 'divyakatha_cookie_banner_dismissed';
    var STORAGE_KEY = 'divyakatha-cookie-notice-dismissed';

    function readCookie(name) {
      var parts = document.cookie ? document.cookie.split(';') : [];
      for (var i = 0; i < parts.length; i++) {
        var pair = parts[i].trim();
        if (pair.indexOf(name + '=') === 0) {
          return decodeURIComponent(pair.slice(name.length + 1));
        }
      }
      return null;
    }

    function isDismissed() {
      if (readCookie(COOKIE_NAME) === '1') return true;
      try {
        return localStorage.getItem(STORAGE_KEY) === '1';
      } catch (e) {
        return false;
      }
    }

    function persistDismiss() {
      document.cookie =
        COOKIE_NAME + '=1; max-age=31536000; path=/; SameSite=Lax';
      try {
        localStorage.setItem(STORAGE_KEY, '1');
      } catch (e) {
        /* ignore */
      }
    }

    function dismissNotice(notice) {
      notice.hidden = true;
      notice.setAttribute('aria-hidden', 'true');
      persistDismiss();
    }

    function initCookieNotice() {
      var notice = document.getElementById('cookie-notice');
      var dismiss = document.getElementById('cookie-notice-dismiss');
      if (!notice || !dismiss) return;

      if (isDismissed()) return;

      notice.hidden = false;
      notice.removeAttribute('aria-hidden');

      dismiss.addEventListener('click', function (event) {
        event.preventDefault();
        dismissNotice(notice);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCookieNotice);
    } else {
      initCookieNotice();
    }
  })();
</script>

<style>
  .cookie-notice {
    position: fixed;
    z-index: 50;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: min(34rem, calc(100vw - 2rem));
    padding: 0.7rem 0.85rem 0.7rem 1rem;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    box-shadow: 0 8px 28px rgba(97, 74, 38, 0.1);
    font-family: var(--font-head);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    line-height: 1.55;
    color: var(--ink-faint);
  }

  /* Author `display: flex` overrides the UA [hidden] rule in WebKit/Chromium. */
  .cookie-notice[hidden] {
    display: none !important;
  }

  .cookie-notice p {
    margin: 0;
    flex: 1;
  }

  .cookie-notice a {
    color: var(--link);
    text-decoration: none;
  }

  .cookie-notice a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cookie-notice button {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin: -0.5rem -0.35rem -0.5rem 0;
    padding: 0;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--ink-faint);
    background: transparent;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s;
  }

  .cookie-notice button:hover,
  .cookie-notice button:active {
    color: var(--ink);
  }
</style>
