---
import Marigold from '../components/Marigold.astro';
import CookieNotice from '../components/CookieNotice.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S7DXESED8M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-S7DXESED8M');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Marcellus&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="corner corner-tl"><Marigold size={150} /></div>
    <div class="corner corner-br"><Marigold size={190} /></div>

    <header class="site-header">
      <a href="/" class="site-name">Divya Katha</a>
      <p class="site-tagline">quiet stories from the temples of India</p>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-ornament">
        <span class="footer-line"></span>
        <Marigold size={26} class="footer-flower" />
        <span class="footer-line"></span>
      </div>
      <p class="footer-text">DivyaKatha · temple tales, told gently</p>
      <p class="footer-text">
        <a href="/about/">About</a>
        <span aria-hidden="true"> · </span>
        <a href="/contact/">Contact</a>
        <span aria-hidden="true"> · </span>
        <a href="/privacy-policy/">Privacy</a>
        <span aria-hidden="true"> · </span>
        <a href="/cookies/">Cookies</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms/">Terms</a>
      </p>
      <p class="footer-text footer-copy">© {year} DivyaKatha · Rishabh Anand</p>
    </footer>

    <CookieNotice />
  </body>
</html>

<style is:global>
  :root {
    --paper: #fbf7ee;
    --paper-deep: #f3ecdc;
    --ink: #3c332a;
    --ink-soft: #7c6f5e;
    --ink-faint: #a2957f;
    --hairline: #e5dbc5;
    --marigold: #e39f2f;
    --marigold-deep: #c97f1c;
    --marigold-light: #f2b84b;
    --marigold-core: #8a5314;
    --link: #a25a2a;
    --font-title: 'Kaushan Script', cursive;
    --font-head: 'Marcellus', serif;
    --font-body: 'Source Serif 4', Georgia, serif;
  }

  * { box-sizing: border-box; }

  html {
    background: var(--paper);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.85;
    /* faint warm wash toward the top, like morning light on stone */
    background:
      radial-gradient(1200px 500px at 50% -100px, rgba(227, 159, 47, 0.07), transparent 70%),
      var(--paper);
  }

  main { flex: 1; width: 100%; }

  ::selection { background: rgba(227, 159, 47, 0.3); }

  /* --- corner marigolds, deliberately faint --- */
  .corner {
    position: fixed;
    z-index: 0;
    opacity: 0.13;
    pointer-events: none;
  }
  .corner-tl { top: -48px; left: -48px; transform: rotate(-12deg); }
  .corner-br { bottom: -62px; right: -62px; transform: rotate(14deg); }
  @media (max-width: 640px) {
    .corner { opacity: 0.09; }
    .corner-tl { transform: rotate(-12deg) scale(0.65); transform-origin: top left; }
    .corner-br { transform: rotate(14deg) scale(0.65); transform-origin: bottom right; }
  }

  /* --- header --- */
  .site-header {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 3.5rem 1.5rem 0.5rem;
  }
  .site-name {
    font-family: var(--font-title);
    font-size: 2rem;
    color: var(--marigold-deep);
    text-decoration: none;
  }
  .site-name:hover { color: var(--marigold); }
  .site-tagline {
    margin: 0.35rem 0 0;
    font-family: var(--font-head);
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* --- footer --- */
  .site-footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 3rem 1.5rem 3.5rem;
    color: var(--ink-faint);
    font-family: var(--font-head);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .footer-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .footer-line {
    display: inline-block;
    width: 72px;
    height: 1px;
    background: var(--hairline);
  }
  .footer-flower { opacity: 0.55; }

  .footer-text {
    margin: 0 0 0.6rem;
  }

  .footer-text a {
    color: inherit;
    text-decoration: none;
  }

  .footer-text a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-copy {
    margin-bottom: 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  /* --- shared article / prose (posts + static pages) --- */
  article {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .post-header {
    text-align: center;
    margin: 2.5rem 0 2.75rem;
  }

  .post-title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(2.1rem, 5.5vw, 3rem);
    line-height: 1.45;
    margin: 0 0 1.1rem;
    color: var(--ink);
  }

  .post-meta {
    font-size: 0.92rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .prose p { margin: 0 0 1.5rem; }

  .prose p:first-of-type::first-letter {
    font-family: var(--font-title);
    font-size: 3.1em;
    line-height: 0.9;
    color: var(--marigold-deep);
    float: left;
    padding: 0.08em 0.12em 0 0;
  }

  .prose--plain p:first-of-type::first-letter {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    float: none;
    padding: 0;
  }

  .prose h2 {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 1.55rem;
    line-height: 1.5;
    color: var(--ink);
    margin: 3rem 0 1.1rem;
  }

  .prose h2::before {
    content: '❁';
    color: var(--marigold);
    font-size: 0.75em;
    margin-right: 0.6em;
  }

  .prose h3 {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 1.25rem;
    margin: 2.2rem 0 0.9rem;
  }

  .prose strong { color: #55432c; }
  .prose em { color: var(--ink-soft); }

  .prose a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: rgba(162, 90, 42, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }

  .prose a:hover { text-decoration-color: var(--link); }

  .prose blockquote {
    margin: 2rem 0;
    padding: 0.2rem 0 0.2rem 1.4rem;
    border-left: 3px solid var(--marigold);
    color: var(--ink-soft);
    font-style: italic;
  }

  .prose ol,
  .prose ul { padding-left: 1.4rem; margin: 0 0 1.5rem; }
  .prose li { margin-bottom: 0.5rem; }

  .prose img {
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(97, 74, 38, 0.16);
    margin: 2rem 0;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--hairline);
    margin: 3rem auto;
    width: 60%;
  }

  .author {
    margin: 3rem auto 0;
    max-width: 30rem;
    text-align: center;
    border-top: 1px solid var(--hairline);
    padding-top: 2rem;
  }

  .author-name {
    font-family: var(--font-head);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--marigold-deep);
    margin: 0 0 0.5rem;
  }

  .author-bio {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .back {
    text-align: center;
    margin-top: 3rem;
  }

  .back a {
    font-family: var(--font-head);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: var(--link);
    text-decoration: none;
  }

  .back a:hover { text-decoration: underline; }

  img { max-width: 100%; height: auto; }
</style>
