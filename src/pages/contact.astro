---
import Base from '../layouts/Base.astro';
import StaticPage from '../components/StaticPage.astro';
---

<Base
  title="Contact — DivyaKatha"
  description="Contact Rishabh Anand, publisher of DivyaKatha."
>
  <StaticPage
    title="Contact"
    description="We read every message."
  >
    <p>
      For questions about DivyaKatha, corrections to a story, privacy requests, or general feedback,
      please email:
    </p>

    <aside class="author">
      <p class="author-name">Rishabh Anand</p>
      <p class="author-bio">
        <a href="mailto:admin@rishabh-anand.com">admin@rishabh-anand.com</a>
      </p>
    </aside>

    <p>
      We aim to reply within a few working days. Please include the page URL if your message relates
      to a specific post.
    </p>

    <p>
      For legal and privacy matters, you may also refer to our
      <a href="/privacy-policy/">Privacy Policy</a> and <a href="/terms/">Terms of Use</a>.
    </p>
  </StaticPage>
</Base>
