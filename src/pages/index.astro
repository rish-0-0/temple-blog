---
import Base from '../layouts/Base.astro';
import { getTemplePosts } from '../lib/strapi';

const posts = await getTemplePosts();

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Divya Katha — Temple Tales of India"
  description="Quiet, story-first reads on the famous temples of India — folklore, history, and why people still believe."
>
  <section class="intro">
    <h1>Temple Tales of India</h1>
    <p>
      Short, unhurried stories of sacred places — the legends beneath the stone,
      and the light that keeps people returning.
    </p>
  </section>

  <section class="post-list">
    {posts.map((post) => (
      <a class="card" href={`/posts/${post.slug}/`}>
        {post.cover_image && (
          <img
            class="card-img"
            src={post.cover_image.formats?.medium?.url ?? post.cover_image.url}
            alt={post.cover_image.alternativeText ?? post.temple_name}
            loading="lazy"
          />
        )}
        <div class="card-body">
          <p class="card-place">{post.temple_name} · {post.state}</p>
          <h2 class="card-title">{post.title}</h2>
          <p class="card-meta">
            {fmtDate(post.publishedAt)}
            {post.author && <> · {post.author.display_name}</>}
          </p>
        </div>
      </a>
    ))}
  </section>
</Base>

<style>
  .intro {
    text-align: center;
    max-width: 34rem;
    margin: 2.5rem auto 3.5rem;
    padding: 0 1.5rem;
  }
  .intro h1 {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    color: var(--ink);
    margin: 0 0 1rem;
    line-height: 1.3;
  }
  .intro p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
  }

  .post-list {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    display: grid;
    gap: 2.5rem;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fffdf8;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .card:hover {
    box-shadow: 0 10px 34px rgba(97, 74, 38, 0.13);
    transform: translateY(-2px);
  }
  .card-img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    display: block;
  }
  .card-body { padding: 1.6rem 2rem 1.8rem; }
  .card-place {
    font-family: var(--font-head);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--marigold-deep);
    margin: 0 0 0.5rem;
  }
  .card-title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.4;
    margin: 0 0 0.6rem;
    color: var(--ink);
  }
  .card:hover .card-title { color: var(--link); }
  .card-meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
</style>
