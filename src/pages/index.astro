---
import Base from '../layouts/Base.astro';
import IndiaMap from '../components/IndiaMap.astro';
import { getTemplePosts } from '../lib/strapi';
import { shortDescription } from '../lib/excerpt';

const posts = await getTemplePosts();
const latestPosts = posts.slice(0, 5);

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const descriptions = Object.fromEntries(posts.map((p) => [p.slug, shortDescription(p)]));
---
<Base
  title="Divya Katha — Temple Tales of India"
  description="Quiet, story-first reads on the famous temples of India — folklore, history, and why people still believe."
>
  <section class="intro">
    <h1>Temple Tales of India</h1>
    <p>
      Short, unhurried stories of sacred places — the legends beneath the stone,
      and the light that keeps people returning.
    </p>
  </section>

  <section class="map-section">
    <IndiaMap posts={posts} descriptions={descriptions} />
    <p class="map-hint">tap a marker to find its story</p>
  </section>

  <section class="post-grid-section">
    <h2 class="grid-heading">Latest tales</h2>
    <div class="post-grid">
      {latestPosts.map((post) => (
        <a class="card" href={`/posts/${post.slug}/`}>
          {post.cover_image && (
            <img
              class="card-img"
              src={post.cover_image.formats?.small?.url ?? post.cover_image.formats?.medium?.url ?? post.cover_image.url}
              alt={post.cover_image.alternativeText ?? post.temple_name}
              loading="lazy"
            />
          )}
          <div class="card-body">
            <p class="card-place">{post.temple_name} · {post.state}</p>
            <h3 class="card-title">{post.title}</h3>
            {descriptions[post.slug] && <p class="card-desc">{descriptions[post.slug]}</p>}
            <p class="card-meta">
              {fmtDate(post.publishedAt)}
              {post.author && <> · {post.author.display_name}</>}
            </p>
          </div>
        </a>
      ))}
    </div>
    {posts.length > 5 && (
      <p class="view-all">
        <a href="/posts/">view all tales →</a>
      </p>
    )}
  </section>
</Base>

<style>
  .intro {
    text-align: center;
    max-width: 34rem;
    margin: 2.5rem auto 3rem;
    padding: 0 1.5rem;
  }
  .intro h1 {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    color: var(--ink);
    margin: 0 0 1rem;
    line-height: 1.3;
  }
  .intro p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
  }

  .map-section {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    margin: 0 auto 4rem;
  }
  .map-hint {
    text-align: center;
    font-family: var(--font-head);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 1.6rem 0 0;
  }

  .post-grid-section {
    position: relative;
    z-index: 1;
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }
  .grid-heading {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 1.4rem;
    text-align: center;
    color: var(--ink);
    margin: 0 0 2rem;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  @media (min-width: 640px) {
    .post-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .post-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    background: #fffdf8;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 1.1rem;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .card:hover {
    box-shadow: 0 10px 34px rgba(97, 74, 38, 0.13);
    transform: translateY(-2px);
  }
  .card-img {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 10px;
    display: block;
  }
  .card-body { min-width: 0; }
  .card-place {
    font-family: var(--font-head);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marigold-deep);
    margin: 0 0 0.3rem;
  }
  .card-title {
    font-family: var(--font-head);
    font-weight: 400;
    font-size: 1.08rem;
    line-height: 1.45;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .card:hover .card-title { color: var(--link); }
  .card-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .view-all {
    text-align: center;
    margin: 2.2rem 0 0;
  }
  .view-all a {
    font-family: var(--font-head);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--link);
    text-decoration: none;
  }
  .view-all a:hover { text-decoration: underline; }
</style>
