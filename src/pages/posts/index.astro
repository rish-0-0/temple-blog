---
import Base from '../../layouts/Base.astro';
import { getTemplePosts } from '../../lib/strapi';
import { shortDescription } from '../../lib/excerpt';

const posts = await getTemplePosts();

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="All Temple Tales — Divya Katha"
  description="Every temple story on Divya Katha — folklore, history, and why people still believe."
>
  <section class="intro">
    <h1>All Temple Tales</h1>
    <p>Every story so far — wander through them all.</p>
  </section>

  <section class="catalogue">
    {posts.map((post) => (
      <a class="card" href={`/posts/${post.slug}/`}>
        {post.cover_image && (
          <img
            class="card-img"
            src={post.cover_image.formats?.medium?.url ?? post.cover_image.url}
            alt={post.cover_image.alternativeText ?? post.temple_name}
            loading="lazy"
          />
        )}
        <div class="card-body">
          <p class="card-place">{post.temple_name} · {post.state}</p>
          <h2 class="card-title">{post.title}</h2>
          {shortDescription(post) && <p class="card-desc">{shortDescription(post)}</p>}
          <p class="card-meta">
            {fmtDate(post.publishedAt)}
            {post.author && <> · {post.author.display_name}</>}
          </p>
        </div>
      </a>
    ))}
  </section>

  <p class="back"><a href="/">← back home</a></p>
</Base>

<style>
  .intro {
    text-align: center;
    max-width: 34rem;
    margin: 2.5rem auto 3rem;
    padding: 0 1.5rem;
  }
  .intro h1 {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: clamp(2.2rem, 5.5vw, 3rem);
    color: var(--ink);
    margin: 0 0 1rem;
    line-height: 1.3;
  }
  .intro p {
    color: var(--ink-soft);
    font-size: 1.05rem;
    margin: 0;
  }

  .catalogue {
    position: relative;
    z-index: 1;
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.8rem;
  }
  @media (min-width: 640px) {
    .catalogue { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .catalogue { grid-template-columns: repeat(3, 1fr); }
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fffdf8;
    border: 1px solid var(--hairline);
    border-radius: 14px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .card:hover {
    box-shadow: 0 10px 34px rgba(97, 74, 38, 0.13);
    transform: translateY(-2px);
  }
  .card-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .card-body { padding: 1.4rem 1.6rem 1.6rem; }
  .card-place {
    font-family: var(--font-head);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--marigold-deep);
    margin: 0 0 0.5rem;
  }
  .card-title {
    font-family: var(--font-title);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.4;
    margin: 0 0 0.55rem;
    color: var(--ink);
  }
  .card:hover .card-title { color: var(--link); }
  .card-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 0.7rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .back {
    text-align: center;
    margin: 3rem 0 0;
  }
  .back a {
    font-family: var(--font-head);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    color: var(--link);
    text-decoration: none;
  }
  .back a:hover { text-decoration: underline; }
</style>
